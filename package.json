{
  "name": "driveaccessapp",
  "productName": "DriveAccessApp",
  "version": "1.0.0",
  "description": "Electron desktop app: Employee records CRUD stored as JSON in Google Drive",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.driveaccess.employeerecords",
    "productName": "DriveAccessApp",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "DriveAccessApp-Setup-${version}.${ext}"
    }
  }
}
